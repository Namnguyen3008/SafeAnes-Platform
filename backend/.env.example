# Use the repository-root .env.example as the canonical local configuration.
SAFEANES_ENV=local
SAFEANES_APP_MODE=VITALDB_REPLAY
SAFEANES_LOG_LEVEL=INFO
SAFEANES_DATA_ROOT=./backend/data
SAFEANES_MODEL_ROOT=./models
SAFEANES_RUNTIME_DEVICE=cpu
SAFEANES_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAFEANES_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
MODEL_REGISTRY_PATH=./backend/app/ml/registry/model_registry.json
UC04_MODEL_PATH=./models/safeanes_uc04_model/model.pt
UC05_MODEL_PATH=./models/safeanes_uc05_respformer_v1/respformer.pt
SAFEANES_API_TOKEN=
SAFEANES_OFFLOAD_INFERENCE=false
SAFEANES_INFERENCE_URL=
SAFEANES_INFERENCE_SERVICE_TOKEN=
SAFEANES_MAX_SIGNAL_RANGE_SECONDS=3600
SAFEANES_MAX_WAVEFORM_RANGE_SECONDS=120
SAFEANES_MAX_SAMPLES=200000
SAFEANES_SIGNAL_FILE_CACHE_ENTRIES=24
SAFEANES_MODEL_SERIES_CACHE_ENTRIES=2
SAFEANES_PREDICTION_CACHE_ENTRIES=2
