# Next.js server-side API target; for local development use 127.0.0.1.
SAFEANES_API_URL=http://127.0.0.1:8000
SAFEANES_BACKEND_URL=http://127.0.0.1:8000
SAFEANES_BACKEND_API_TOKEN=

# Backend runtime configuration. Relative paths are resolved from this repository root.
SAFEANES_ENV=local
SAFEANES_APP_MODE=VITALDB_REPLAY
SAFEANES_LOG_LEVEL=INFO
SAFEANES_RUNTIME_DEVICE=cpu
SAFEANES_DATA_ROOT=./backend/data
SAFEANES_MODEL_ROOT=../model
MODEL_REGISTRY_PATH=./backend/app/ml/registry/model_registry.json
UC04_MODEL_PATH=../model/safeanes_uc04_model/model.pt
UC05_MODEL_PATH=../model/safeanes_uc05_respformer_v1/respformer.pt
SAFEANES_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SAFEANES_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend

# Docker bind-mount sources, relative to docker-compose.yml.
SAFEANES_DATA_HOST_PATH=./backend/data
MODEL_ARTIFACTS_DIR=../model

# Bounded response/cache limits.
SAFEANES_MAX_SIGNAL_RANGE_SECONDS=3600
SAFEANES_MAX_WAVEFORM_RANGE_SECONDS=120
SAFEANES_MAX_SAMPLES=200000
SAFEANES_SIGNAL_FILE_CACHE_ENTRIES=24
SAFEANES_MODEL_SERIES_CACHE_ENTRIES=2
SAFEANES_PREDICTION_CACHE_ENTRIES=2

# Set at least 16 random characters for production and copy the same value to
# SAFEANES_BACKEND_API_TOKEN. Do not commit a real secret.
SAFEANES_API_TOKEN=
